$doctorLoader = @'
<script src="appointment-engine.js"></script>
<script>
window.addEventListener("load", function () {
  async function fillDoctors() {
    try {
      if (!window.DOCTORS) window.DOCTORS = await apiRequest("/api/doctors");
      const opts = window.DOCTORS.map(d => `<option value="${esc(d.username)}">${esc(d.fullName)}</option>`).join("");
      ["fDoctor", "apDoctor"].forEach(id => { const el = document.getElementById(id); if (el) el.innerHTML = opts; });
    } catch (e) { console.warn("Could not load doctors", e); }
  }
  fillDoctors();
  const ub = document.getElementById("uploadBtn");
  if (ub) ub.addEventListener("click", fillDoctors);
});
</script>
'@
